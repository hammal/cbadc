{
  "name": "cbadc",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "overrideCommand": true,
  "containerEnv": { "UV_PROJECT_ENVIRONMENT": "/cbadc/.venv" },
  "postCreateCommand": "uv sync --extra dev --extra docs --extra delsig",
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "/cbadc/.venv/bin/python" },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "redhat.vscode-yaml"
      ]
    }
  }
}
